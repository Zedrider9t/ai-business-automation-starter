{
  "name": "ai-business-automation-starter",
  "version": "0.1.0",
  "private": false,
  "description": "Provider-agnostic TypeScript starter for practical AI-assisted business automation workflows.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
