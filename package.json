  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "automation",
    "business-automation",
    "typescript",
    "lead-qualification",
    "workflow"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
